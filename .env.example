# Copy to .env.local and fill in from Supabase → Project Settings → API / Database.
# The app (safe to expose in the browser):
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Setup scripts only (never commit these):
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres
SUPABASE_SECRET_KEY=sb_secret_...
DEMO_PASSWORD=choose-a-demo-password
